{
  "id": "com.intellivent.fresh",
  "version": "0.4.8",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Fresh Intellivent",
    "sv": "Fresh Intellivent"
  },
  "description": {
    "en": "Intelligent ventilation for your bathroom",
    "sv": "Intelligent ventilation för ditt badrum"
  },
  "category": ["climate"],
  "tags": {
    "en": ["ventilation", "fan", "bathroom fan", "intellivent", "fresh", "bluetooth", "ble"],
    "sv": ["ventilation", "fläkt", "badrumsfläkt", "intellivent", "fresh", "bluetooth", "ble"]
  },
  "permissions": ["homey:wireless:ble"],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "JYxfeldt"
  },
  "contributors": {
    "developers": [
      {
        "name": "JYxfeldt"
      },
      {
        "name": "Kristoffer Konstad Hansen"
      },
      {
        "name": "LaStrada (pyfreshintellivent)"
      }
    ]
  },
  "source": "https://github.com/JYxfeldt/Homey-Intellivent",
  "homepage": "https://github.com/JYxfeldt/Homey-Intellivent",
  "support": "https://github.com/JYxfeldt/Homey-Intellivent/issues",
  "brandColor": "#00A0E3",
  "drivers": [
    {
      "id": "intellivent-sky",
      "name": {
        "en": "Intellivent Sky",
        "sv": "Intellivent Sky"
      },
      "class": "fan",
      "capabilities": ["onoff", "measure_rpm", "intellivent_rpm", "measure_humidity", "measure_temperature", "intellivent_mode", "intellivent_humidity_enabled", "intellivent_humidity_sensitivity", "intellivent_light_enabled", "intellivent_light_sensitivity", "intellivent_voc_enabled", "intellivent_voc_sensitivity", "intellivent_boost"],
      "capabilitiesOptions": {
        "intellivent_rpm": {
          "min": 800,
          "max": 2400,
          "step": 100,
          "title": {
            "en": "Fan Speed",
            "sv": "Fläkthastighet"
          },
          "preventTag": false,
          "preventInsights": false
        }
      },
      "platforms": ["local"],
      "connectivity": ["ble"],
      "images": {
        "small": "/drivers/intellivent-sky/assets/images/small.jpg",
        "large": "/drivers/intellivent-sky/assets/images/large.jpg",
        "xlarge": "/drivers/intellivent-sky/assets/images/xlarge.jpg"
      },
      "pair": [
        {
          "id": "instructions",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "instructions",
            "next": "add_devices"
          },
          "options": {
            "singular": false
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Authentication",
            "sv": "Autentisering"
          },
          "children": [
            {
              "id": "auth_code",
              "type": "label",
              "label": {
                "en": "Authentication Code",
                "sv": "Autentiseringskod"
              },
              "hint": {
                "en": "Read automatically from the fan when it is added in pairing mode. 00000000 means Homey can read the fan but not control it: put the fan in pairing mode and run Repair on the device.",
                "sv": "Läses automatiskt från fläkten när den läggs till i parkopplingsläge. 00000000 betyder att Homey kan läsa av fläkten men inte styra den: sätt fläkten i parkopplingsläge och kör Reparera på enheten."
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Device Information",
            "sv": "Enhetsinformation"
          },
          "children": [
            {
              "id": "firmware_version",
              "type": "label",
              "label": {
                "en": "Firmware Version",
                "sv": "Firmwareversion"
              },
              "value": "Unknown"
            },
            {
              "id": "hardware_version",
              "type": "label",
              "label": {
                "en": "Hardware Version",
                "sv": "Hårdvaruversion"
              },
              "value": "Unknown"
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Boost",
            "sv": "Boost"
          },
          "children": [
            {
              "id": "boost_rpm",
              "type": "number",
              "label": {
                "en": "Boost Speed",
                "sv": "Boosthastighet"
              },
              "hint": {
                "en": "Fan speed used by the Boost button on the device tile",
                "sv": "Fläkthastighet som Boost-knappen på enhetsrutan använder"
              },
              "value": 2400,
              "min": 800,
              "max": 2400,
              "step": 100,
              "units": "RPM"
            },
            {
              "id": "boost_minutes",
              "type": "number",
              "label": {
                "en": "Boost Duration",
                "sv": "Boosttid"
              },
              "hint": {
                "en": "How long the Boost button runs, in minutes",
                "sv": "Hur länge Boost-knappen kör, i minuter"
              },
              "value": 15,
              "min": 1,
              "max": 60,
              "step": 1,
              "units": "min"
            }
          ]
        }
      ]
    }
  ],
  "capabilities": {
    "measure_rpm": {
      "type": "number",
      "title": {
        "en": "Current RPM",
        "sv": "Aktuellt varvtal"
      },
      "units": {
        "en": "RPM",
        "sv": "RPM"
      },
      "min": 0,
      "max": 2400,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "intellivent_mode": {
      "type": "enum",
      "title": {
        "en": "Mode",
        "sv": "Läge"
      },
      "values": [
        {
          "id": "off",
          "title": {
            "en": "Off",
            "sv": "Av"
          }
        },
        {
          "id": "constant_speed",
          "title": {
            "en": "Constant Speed",
            "sv": "Konstant hastighet"
          }
        },
        {
          "id": "humidity",
          "title": {
            "en": "Humidity",
            "sv": "Luftfuktighet"
          }
        },
        {
          "id": "light",
          "title": {
            "en": "Light",
            "sv": "Ljus"
          }
        },
        {
          "id": "voc",
          "title": {
            "en": "VOC",
            "sv": "VOC"
          }
        },
        {
          "id": "timer",
          "title": {
            "en": "Timer",
            "sv": "Timer"
          }
        },
        {
          "id": "boost",
          "title": {
            "en": "Boost",
            "sv": "Boost"
          }
        },
        {
          "id": "airing",
          "title": {
            "en": "Airing",
            "sv": "Vädring"
          }
        },
        {
          "id": "pause",
          "title": {
            "en": "Pause",
            "sv": "Paus"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker"
    },
    "intellivent_rpm": {
      "type": "number",
      "title": {
        "en": "RPM",
        "sv": "RPM"
      },
      "units": {
        "en": "RPM",
        "sv": "RPM"
      },
      "min": 800,
      "max": 2400,
      "step": 100,
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "insights": true
    },
    "intellivent_humidity_enabled": {
      "type": "boolean",
      "title": {
        "en": "Humidity Detection",
        "sv": "Fuktstyrning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "intellivent_humidity_sensitivity": {
      "type": "enum",
      "title": {
        "en": "Humidity Sensitivity",
        "sv": "Fuktkänslighet"
      },
      "values": [
        {
          "id": "1",
          "title": {
            "en": "Low",
            "sv": "Låg"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Medium",
            "sv": "Medel"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "High",
            "sv": "Hög"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker"
    },
    "intellivent_light_enabled": {
      "type": "boolean",
      "title": {
        "en": "Light Detection",
        "sv": "Ljusstyrning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "intellivent_light_sensitivity": {
      "type": "enum",
      "title": {
        "en": "Light Sensitivity",
        "sv": "Ljuskänslighet"
      },
      "values": [
        {
          "id": "1",
          "title": {
            "en": "Low",
            "sv": "Låg"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Medium",
            "sv": "Medel"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "High",
            "sv": "Hög"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker"
    },
    "intellivent_voc_enabled": {
      "type": "boolean",
      "title": {
        "en": "Smell Detection",
        "sv": "Luktstyrning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "intellivent_voc_sensitivity": {
      "type": "enum",
      "title": {
        "en": "Smell Sensitivity",
        "sv": "Luktkänslighet"
      },
      "values": [
        {
          "id": "1",
          "title": {
            "en": "Low",
            "sv": "Låg"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Medium",
            "sv": "Medel"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "High",
            "sv": "Hög"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker"
    },
    "intellivent_boost": {
      "type": "boolean",
      "title": {
        "en": "Boost",
        "sv": "Boost"
      },
      "desc": {
        "en": "Run the fan at the configured boost speed for the configured duration",
        "sv": "Kör fläkten på inställd boosthastighet under inställd tid"
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "mode_changed",
        "title": {
          "en": "Mode changed",
          "sv": "Läget ändrades"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "example": "humidity"
          },
          {
            "name": "mode_name",
            "type": "string",
            "title": {
              "en": "Mode name",
              "sv": "Lägets namn"
            },
            "example": {
              "en": "Humidity",
              "sv": "Luftfuktighet"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          }
        ]
      },
      {
        "id": "humidity_changed",
        "title": {
          "en": "Humidity changed",
          "sv": "Luftfuktigheten ändrades"
        },
        "tokens": [
          {
            "name": "humidity",
            "type": "number",
            "title": {
              "en": "Humidity",
              "sv": "Luftfuktighet"
            },
            "example": 65
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "mode_is",
        "title": {
          "en": "Mode !{{is|is not}} ...",
          "sv": "Läget !{{är|är inte}} ..."
        },
        "titleFormatted": {
          "en": "Mode !{{is|is not}} [[mode]]",
          "sv": "Läget !{{är|är inte}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off",
                  "sv": "Av"
                }
              },
              {
                "id": "constant_speed",
                "label": {
                  "en": "Constant Speed",
                  "sv": "Konstant hastighet"
                }
              },
              {
                "id": "humidity",
                "label": {
                  "en": "Humidity",
                  "sv": "Luftfuktighet"
                }
              },
              {
                "id": "light",
                "label": {
                  "en": "Light",
                  "sv": "Ljus"
                }
              },
              {
                "id": "voc",
                "label": {
                  "en": "VOC",
                  "sv": "VOC"
                }
              },
              {
                "id": "timer",
                "label": {
                  "en": "Timer",
                  "sv": "Timer"
                }
              },
              {
                "id": "boost",
                "label": {
                  "en": "Boost",
                  "sv": "Boost"
                }
              },
              {
                "id": "airing",
                "label": {
                  "en": "Airing",
                  "sv": "Vädring"
                }
              },
              {
                "id": "pause",
                "label": {
                  "en": "Pause",
                  "sv": "Paus"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_mode",
        "title": {
          "en": "Set mode",
          "sv": "Ställ in läge"
        },
        "titleFormatted": {
          "en": "Set mode to [[mode]]",
          "sv": "Ställ in läget [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off",
                  "sv": "Av"
                }
              },
              {
                "id": "constant_speed",
                "label": {
                  "en": "Constant Speed",
                  "sv": "Konstant hastighet"
                }
              },
              {
                "id": "humidity",
                "label": {
                  "en": "Humidity",
                  "sv": "Luftfuktighet"
                }
              },
              {
                "id": "light",
                "label": {
                  "en": "Light",
                  "sv": "Ljus"
                }
              },
              {
                "id": "voc",
                "label": {
                  "en": "VOC",
                  "sv": "VOC"
                }
              },
              {
                "id": "timer",
                "label": {
                  "en": "Timer",
                  "sv": "Timer"
                }
              },
              {
                "id": "boost",
                "label": {
                  "en": "Boost",
                  "sv": "Boost"
                }
              },
              {
                "id": "airing",
                "label": {
                  "en": "Airing",
                  "sv": "Vädring"
                }
              },
              {
                "id": "pause",
                "label": {
                  "en": "Pause",
                  "sv": "Paus"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_rpm",
        "title": {
          "en": "Set fan speed",
          "sv": "Ställ in fläkthastighet"
        },
        "titleFormatted": {
          "en": "Set fan speed to [[rpm]] RPM",
          "sv": "Ställ in fläkthastigheten på [[rpm]] RPM"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          },
          {
            "type": "range",
            "name": "rpm",
            "title": {
              "en": "RPM",
              "sv": "RPM"
            },
            "min": 800,
            "max": 2400,
            "step": 100
          }
        ]
      },
      {
        "id": "start_boost",
        "title": {
          "en": "Start boost",
          "sv": "Starta boost"
        },
        "titleFormatted": {
          "en": "Start boost for [[duration]] minutes at [[rpm]] RPM",
          "sv": "Starta boost i [[duration]] minuter på [[rpm]] RPM"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          },
          {
            "type": "range",
            "name": "duration",
            "title": {
              "en": "Minutes",
              "sv": "Minuter"
            },
            "min": 1,
            "max": 60,
            "step": 1
          },
          {
            "type": "range",
            "name": "rpm",
            "title": {
              "en": "RPM",
              "sv": "RPM"
            },
            "min": 800,
            "max": 2400,
            "step": 100
          }
        ]
      },
      {
        "id": "configure_humidity",
        "title": {
          "en": "Configure humidity detection",
          "sv": "Ställ in fuktstyrning"
        },
        "titleFormatted": {
          "en": "Humidity detection [[enabled]], [[sensitivity]] sensitivity, [[rpm]] RPM",
          "sv": "Fuktstyrning [[enabled]], [[sensitivity]] känslighet, [[rpm]] RPM"
        },
        "hint": {
          "en": "Turns humidity detection on or off, and sets how sensitive it is and how fast the fan runs when the humidity rises.",
          "sv": "Slår på eller av fuktstyrningen och ställer in hur känslig den är och hur fort fläkten går när luftfuktigheten stiger."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=intellivent-sky"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "On or off",
              "sv": "På eller av"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "Enabled",
                  "sv": "På"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "Disabled",
                  "sv": "Av"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "sensitivity",
            "title": {
              "en": "Sensitivity",
              "sv": "Känslighet"
            },
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "Low",
                  "sv": "Låg"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "Medium",
                  "sv": "Medel"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "High",
                  "sv": "Hög"
                }
              }
            ]
          },
          {
            "type": "range",
            "name": "rpm",
            "title": {
              "en": "RPM",
              "sv": "RPM"
            },
            "min": 800,
            "max": 2400,
            "step": 100
          }
        ]
      }
    ]
  }
}
